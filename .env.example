# Core runtime
KNOWLEDGE_ESCROW_DATA_DIR=~/.knowledge-escrow
KNOWLEDGE_ESCROW_PROJECT_ROOT=
# Optional explicit project registry for MEMORY.md routing: comma-separated
# name=path pairs.
KNOWLEDGE_ESCROW_PROJECT_ROOTS=
KNOWLEDGE_ESCROW_USER_MEMORY_ROOT=
KNOWLEDGE_ESCROW_GREP_ROOTS=
KNOWLEDGE_ESCROW_HOT_MEMORY_DIRS=
KNOWLEDGE_ESCROW_HOT_MEMORY_HOURS=72
KNOWLEDGE_ESCROW_ENABLE_WRITES=1
KNOWLEDGE_ESCROW_METRICS_ENABLED=1
KNOWLEDGE_ESCROW_METRICS_RETENTION_DAYS=30
KNOWLEDGE_ESCROW_HEALTH_FRESHNESS_MINUTES=1440
KNOWLEDGE_ESCROW_HTTP_HOST=127.0.0.1
KNOWLEDGE_ESCROW_HTTP_PORT=3155

# Local SQLite document store (FTS5 + optional vector search).
KNOWLEDGE_ESCROW_SQLITE=1
KNOWLEDGE_ESCROW_SQLITE_PATH=

# Write-time PII redaction (SSNs, emails, phone numbers, etc). Off by default.
KNOWLEDGE_ESCROW_REDACTION=1
# Optional JSON array of extra {name, regex, flags?} detectors.
KNOWLEDGE_ESCROW_REDACTION_PATTERNS=

# Embedding provider for semantic search: none | deterministic | ollama | local
KNOWLEDGE_ESCROW_EMBEDDING_PROVIDER=none
KNOWLEDGE_ESCROW_OLLAMA_URL=http://127.0.0.1:11434
KNOWLEDGE_ESCROW_OLLAMA_MODEL=nomic-embed-text
# Directory holding the local static-embedding model's model.safetensors and
# tokenizer.json (see `npm run fetch-local-model`).
KNOWLEDGE_ESCROW_LOCAL_MODEL_DIR=

# Optional Postgres/pgvector add-on. Leave blank for a file-backed install.
POSTGRES_URL=

# Overrides the MCP serverInfo.name reported to clients.
KNOWLEDGE_ESCROW_SERVER_NAME=

# Optional import sources.
CODEX_SESSIONS_DIR=~/.codex/sessions
CLAUDE_PROJECTS_DIR=~/.claude/projects
