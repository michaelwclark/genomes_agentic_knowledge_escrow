{
  "mcpServers": {
    "knowledge_escrow": {
      "command": "sh",
      "args": ["./bin/escrow"],
      "cwd": ".",
      "env": {
        "KNOWLEDGE_ESCROW_DATA_DIR": "~/.knowledge-escrow",
        "KNOWLEDGE_ESCROW_SQLITE": "1",
        "KNOWLEDGE_ESCROW_EMBEDDING_PROVIDER": "local",
        "KNOWLEDGE_ESCROW_METRICS_ENABLED": "1",
        "KNOWLEDGE_ESCROW_REDACTION": "1",
        "KNOWLEDGE_ESCROW_SERVER_NAME": "knowledge-escrow"
      },
      "default_tools_approval_mode": "approve"
    }
  }
}
